# ==============================================================================
# Game Hub Client Configuration (.env.example)
# Copy this file to .env.local to customize your deployment.
# ==============================================================================

# Custom PeerJS Signaling Server (Optional)
# If omitted, Game Hub uses the standard public cloud signaling broker (0.peerjs.com)
# with Google and Twilio public STUN servers for zero-configuration P2P matchmaking.
# VITE_PEERJS_HOST=
# VITE_PEERJS_PORT=443
# VITE_PEERJS_PATH=/peerjs
# VITE_PEERJS_SECURE=true

# Optional Hosted Backend WebSocket URL (for custom dedicated servers)
# Example: wss://your-backend-service.onrender.com
# VITE_MULTIPLAYER_SERVER_URL=

# Application Display Environment
VITE_APP_NAME="Game Hub"
VITE_APP_VERSION="2.0.0"
